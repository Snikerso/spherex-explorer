NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
# Atlas Free: paste the URI from Connect > Drivers and add database name /spherex.
# Format: mongodb+srv://APP_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/spherex?retryWrites=true&w=majority
# Optional local database: mongodb://127.0.0.1:27017/spherex?replicaSet=rs0&directConnection=true
MONGODB_URI=
DATA_MODE=live
# Application copilot and live evaluation. Keep the key on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
AGENT_TIMEOUT_MS=120000
AGENT_MAX_TURNS=8
# Optional paths (defaults: local data/cache and Python workers/imaging/.venv).
# CACHE_ROOT=
# IMAGING_PYTHON=
# Optional release catalog override; changes are read without restarting the API.
# SPHEREX_RELEASES_FILE=/absolute/path/to/spherex-releases.json

# Cleanup runs hourly; expired sessions and unreferenced cache have a >=24h safety grace.
CLEANUP_INTERVAL_MS=3600000
CACHE_RETENTION_HOURS=24

# DigitalOcean Spaces (all four required together; private, scoped read/write keys in Doppler)
# SPACES_BUCKET=spherex-explorer-assets-dev
# SPACES_REGION=fra1
# SPACES_ACCESS_KEY_ID=
# SPACES_SECRET_ACCESS_KEY=
# SPACES_PREFIX=spherex/v1/
# Unreferenced FITS remain reusable for 90 days; referenced FITS remain retained.
# SPACES_FITS_RETENTION_DAYS=90
