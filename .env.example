NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
APP_ORIGIN=http://localhost:5173
# Atlas Free: wklej URI z Connect > Drivers, dodaj nazwę bazy /spherex.
# Format: mongodb+srv://APP_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/spherex?retryWrites=true&w=majority
# Opcjonalnie lokalnie: mongodb://127.0.0.1:27017/spherex?replicaSet=rs0&directConnection=true
MONGODB_URI=
DATA_MODE=demo
# Tylko do jawnie uruchamianego testu eval:live. Klucz pozostaje na backendzie.
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_TIMEOUT_MS=60000
AGENT_MAX_TURNS=8
