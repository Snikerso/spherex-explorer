{
  "name": "@spherex/api", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "db:init": "tsx src/scripts/init-db.ts",
    "eval:live": "tsx test/agent/live.ts",
    "demo:scenario": "tsx test/agent/demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0", "@nestjs/core": "12.4.0", "@nestjs/platform-express": "12.4.0",
    "@nestjs/mongoose": "12.0.1", "@openai/agents": "0.21.0",
    "@spherex/contracts": "workspace:*", "dotenv": "^17.0.0", "mongoose": "9.12.0",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.0", "zod": "^4.6.7"
  },
  "devDependencies": { "@types/express": "^5.0.0", "tsx": "^4.20.0" }
}
